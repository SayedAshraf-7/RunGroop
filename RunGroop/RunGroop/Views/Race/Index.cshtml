
@model IEnumerable<Race>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<div class="album py-5 bg-light">
    <div class="container">

        <div class="row">

            @foreach (var Race in Model)
            {

                <div class="col-md-4">
                    <div class="card mb-4 box-shadow">
                        <img class="card-img-top" width="100%" height="225" src=@Race.Image alt="Card image cap">
                        <div class="card-body">
                            <p class="card-text">@Race.Title</p>
                            <p class="card-text">@Race.Description</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="btn-group">
                                    <a asp-controller="Race"
                                            asp-action="RaceDetails"
                                            asp-route-id="@Race.Id" type="button" class="btn btn-sm btn-outline-secondary">
                                        View
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-secondary">Edit</button>
                                </div>
                                <small class="text-muted">@Race.RaceCategory</small>
                            </div>
                        </div>
                    </div>
                </div>

            }

        </div>
    </div>
</div>